{
  "name": "firefly-society",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "compile:machine": "tsx scripts/compile-machine.ts",
    "dev": "npm run compile:machine && vite",
    "build": "npm run compile:machine && vite build",
    "preview": "vite preview",
    "check": "npm run compile:machine && svelte-check --tsconfig ./tsconfig.json",
    "model:check": "tsx scripts/check-model.ts",
    "sim:check": "tsx scripts/sim-check.ts",
    "verify": "npm run check && npm run model:check && npm run sim:check && npm run build"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^22.20.5",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "yaml": "^2.6.0"
  }
}
